# Необязательный слой входа (см. README, раздел 7). Без ключей Clerk сайт работает как гостевой.
# Скопируйте в .env.local и заполните. Файлы .env* (кроме этого образца) в git не попадают.

# Clerk: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...           # СЕКРЕТ: только в .env.local и в окружении хостинга

# Администраторы (e-mail через запятую). Альтернатива: в Clerk у пользователя publicMetadata {"role":"admin"}
ADMIN_EMAILS=you@example.com

# База данных. Если DATABASE_URL не задан — файл SQLite (data/devdock.sqlite), ничего настраивать не нужно.
# Для Vercel/облака: PostgreSQL (Neon, Supabase …):
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# SQLITE_PATH=data/devdock.sqlite
